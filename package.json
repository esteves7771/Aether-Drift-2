{
    "name": "aether-drift-2",
    "version": "0.5.0-f",
    "private": true,
    "description": "Aether Drift 2.0 — six-degree-of-freedom arcade space combat",
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite --host 0.0.0.0",
        "fmt": "prettier --check .",
        "fmt:fix": "prettier --write .",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "preview": "vite preview --host 0.0.0.0",
        "start": "vite preview --host 0.0.0.0",
        "test": "vitest run src",
        "test:smoke": "playwright test",
        "typecheck": "tsc --noEmit",
        "music:cue": "node tools/create-death-cue.mjs",
        "test:phase4": "playwright test --config playwright.phase4.config.ts",
        "test:arcade": "playwright test --config playwright.phase4.config.ts",
        "assets:verify": "node tools/verify-models.mjs",
        "assets:catalog": "node tools/build-model-catalog.mjs",
        "test:living": "playwright test --config playwright.phase4.config.ts tests/living.spec.ts tests/guardian.spec.ts --workers=1",
        "build:pages": "vite build --base=/Aether-Drift-2/",
        "test:release": "npm run build:pages && playwright test --config playwright.release.config.ts",
        "release:verify": "node tools/verify-release.mjs",
        "test:thrusters": "playwright test --config playwright.phase4.config.ts tests/thrusters.spec.ts --workers=1",
        "test:menu": "npm run build:pages && playwright test --config playwright.menu.config.ts",
        "test:cinematic": "playwright test --config playwright.phase4.config.ts tests/cinematic.spec.ts --workers=1"
    },
    "dependencies": {
        "playcanvas": "^2.24.0"
    },
    "devDependencies": {
        "@playcanvas/eslint-config": "3.0.0",
        "@playcanvas/inspector": "^0.5.0",
        "@playwright/test": "^1.65.1",
        "eslint": "^9.39.5",
        "prettier": "^3.10.0",
        "typescript": "~6.0.3",
        "vite": "^8.3.8",
        "vitest": "^5.1.0"
    },
    "engines": {
        "node": ">=22.23.2"
    }
}
